import ElectricPower, I2C, ElectricSignal
import Capacitor, Addressor2, Resistor
from "components/nettie.ato" import NetTie

module Texas_Instruments_ADS1219IPWR:
    # External interfaces
    power = new ElectricPower
    power_analog = new ElectricPower
    i2c = new I2C
    reference = new ElectricPower
    input_0 = new ElectricSignal
    input_1 = new ElectricSignal
    input_2 = new ElectricSignal
    input_3 = new ElectricSignal

    # Set required interfaces
    power.required = True
    power_analog.required = True
    i2c.required = True
    reference.required = True

    ic = new _Texas_Instruments_ADS1219IPWR

    # Power
    power.vcc ~ ic.DVDD
    power.gnd ~ ic.DGND
    assert power.voltage within 2.7V to 5.5V

    # power_analog = new ElectricPower # Moved to top
    power_analog.vcc ~ ic.AVDD
    power_analog.gnd ~ ic.AGND

    # Netties
    agnd_nettie = new Resistor
    agnd_nettie.resistance = 0ohm
    agnd_nettie.package = "R0402"
    power.gnd ~ agnd_nettie.p1
    power_analog.gnd ~ agnd_nettie.p2

    avdd_nettie = new Resistor
    avdd_nettie.resistance = 0ohm
    avdd_nettie.package = "R0402"
    power_analog.vcc ~ avdd_nettie.p1
    power.vcc ~ avdd_nettie.p2

    # Input capacitors
    digital_cap = new Capacitor
    digital_cap.capacitance = 100nF +/- 20%
    digital_cap.package = "C0402"
    power ~ digital_cap.power

    analog_cap_1 = new Capacitor
    analog_cap_1.capacitance = 100nF +/- 20%
    analog_cap_1.package = "C0402"
    power_analog ~ analog_cap_1.power

    analog_cap_2 = new Capacitor
    analog_cap_2.capacitance = 10uF +/- 20%
    analog_cap_2.package = "C0603"
    power_analog ~ analog_cap_2.power

    # Inputs
    # input_0 = new ElectricSignal # Moved to top
    input_0.line ~ ic.AIN0
    input_0.reference ~ power_analog

    # input_1 = new ElectricSignal # Moved to top
    input_1.line ~ ic.AIN1
    input_1.reference ~ power_analog

    # input_2 = new ElectricSignal # Moved to top
    input_2.line ~ ic.AIN2
    input_2.reference ~ power_analog

    # input_3 = new ElectricSignal # Moved to top
    input_3.line ~ ic.AIN3
    input_3.reference ~ power_analog

    # Reference
    # reference = new ElectricPower # Moved to top
    reference.vcc ~ ic.REFN
    reference.gnd ~ ic.REFP
    reference.gnd ~ power_analog.gnd

    # Address 0x40
    addressor = new Addressor2
    assert i2c.address is addressor.address
    addressor.base = 0x40
    addressor.address_lines[0].line ~ ic.A0
    addressor.address_lines[0].reference ~ power
    addressor.address_lines[1].line ~ ic.A1
    addressor.address_lines[1].reference ~ power

    # Reset - disabled by default
    ic.RESETh ~ power.vcc

    # i2c = new I2C # Moved to top
    i2c.scl.line ~ ic.SCL
    i2c.sda.line ~ ic.SDA


component _Texas_Instruments_ADS1219IPWR:
    """Texas_Instruments_ADS1219IPWR component"""
    lcsc_id = "C2869313"
    manufacturer = "Texas Instruments"
    mpn = "ADS1219IPWR"
    datasheet_url = "https://wmsc.lcsc.com/wmsc/upload/file/pdf/v2/lcsc/2303010401_Texas-Instruments-ADS1219IPWR_C2869313.pdf"
    designator_prefix = "U"

    # pins
    signal A0 ~ pin 1
    signal A1 ~ pin 2
    signal AGND ~ pin 5
    signal AIN0 ~ pin 11
    signal AIN1 ~ pin 10
    signal AIN2 ~ pin 7
    signal AIN3 ~ pin 6
    signal AVDD ~ pin 12
    signal DGND ~ pin 4
    signal DRDYh ~ pin 14
    signal DVDD ~ pin 13
    signal REFN ~ pin 8
    signal REFP ~ pin 9
    signal RESETh ~ pin 3
    signal SCL ~ pin 16
    signal SDA ~ pin 15


module Test:
    """Test module"""

    adc1 = new Texas_Instruments_ADS1219IPWR
    adc2 = new Texas_Instruments_ADS1219IPWR
    adc3 = new Texas_Instruments_ADS1219IPWR
    adc4 = new Texas_Instruments_ADS1219IPWR

    power = new ElectricPower
    reference = new ElectricPower
    i2c = new I2C

    power ~ adc1.power
    power ~ adc2.power
    power ~ adc3.power
    power ~ adc4.power

    reference ~ adc1.reference
    reference ~ adc2.reference
    reference ~ adc3.reference
    reference ~ adc4.reference

    i2c ~ adc1.i2c
    i2c ~ adc2.i2c
    i2c ~ adc3.i2c
    i2c ~ adc4.i2c

    adc1.i2c.address = 0x40
    adc2.i2c.address = 0x41
    adc3.i2c.address = 0x42
    adc4.i2c.address = 0x43
