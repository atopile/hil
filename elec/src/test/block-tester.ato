    # Power supplies
    ac_in_line = new Sinhoo_SMTSO2515CTJ
    ac_in_neutral = new Sinhoo_SMTSO2515CTJ
    ac_in_chassis = new Sinhoo_SMTSO2515CTJ

    # Blocks
    base_0 = new TestBase
