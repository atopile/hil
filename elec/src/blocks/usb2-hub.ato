import USB2_0, ElectricPower, I2C
from "components/microchip_tech_us_b2514b_im2.ato" import Microchip_Tech_USB2514B_I_M2
from "components/littelfuse_sp0503b_ahtg.ato" import Littelfuse_SP0503BAHTG
from "components/diodes_incorporated_ap22653w67.ato" import Diodes_Incorporated_AP22653W6_7

module USB2Hub:
    """USB2 Hub block"""

    # External Interfaces
    usb2_up = new USB2_0
    usb2_1 = new USB2_0
    usb2_2 = new USB2_0
    usb2_3 = new USB2_0
    usb2_4 = new USB2_0
    power_5v = new ElectricPower
    power_3v3 = new ElectricPower
    power_vbus = new ElectricPower # Current limited output

    power_5v.gnd ~ power_3v3.gnd
    power_5v.gnd ~ power_vbus.gnd

    # Components
    hub = new Microchip_Tech_USB2514B_I_M2
    power_3v3 ~ hub.power_3v3

    # Power switch
    power_switch = new Diodes_Incorporated_AP22653W6_7
    power_5v ~ power_switch.power_in
    power_switch.power_out ~ power_vbus
    hub.vbus_enable ~ power_switch.enable
    power_switch.power_in.gnd ~ power_3v3.gnd

    # Connect hub USB
    usb2_up ~ hub.usb2_up
    usb2_1 ~ hub.usb2_1
    usb2_2 ~ hub.usb2_2
    usb2_3 ~ hub.usb2_3
    usb2_4 ~ hub.usb2_4
