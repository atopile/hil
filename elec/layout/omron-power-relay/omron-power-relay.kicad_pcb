            (plotreference yes)
            (plotvalue yes)
            (plotpadnumbers no)
            (hidednponfab no)
            (sketchdnponfab yes)
            (crossoutdnponfab yes)
            (plotfptext yes)
            (subtractmaskfromsilk no)
            (outputformat 1)
            (mirror no)
            (drillshape 1)
            (scaleselection 1)
            (outputdirectory "")
        )
    )
