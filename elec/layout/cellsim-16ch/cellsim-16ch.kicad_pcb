				(thickness 0.1)
				(material "FR4")
				(epsilon_r 4.5)
				(loss_tangent 0.02)
			)
			(layer "In3.Cu"
				(type "copper")
				(thickness 0.035)
			)
			(layer "dielectric 4"
				(type "core")
				(thickness 0.535)
				(material "FR4")
				(epsilon_r 4.5)
				(loss_tangent 0.02)
