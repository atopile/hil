from "blocks/hil-core.ato" import HILCore
from "blocks/cellsim-8ch.ato" import CellSim8Ch
from "blocks/analog-out-4ch.ato" import AnalogOut4ch
from "blocks/coms-can.ato" import ComsCANISO, TerminatedCAN120R
from "blocks/debug-saleae.ato" import DebugSaleae
from "components/IDC-VSH-connector.ato" import IDCVSH16S, NTCIDC8CH
from "components/db9right_angle_male.ato" import DB9RightAngleMale
from "blocks/thermistor_8ch.ato" import Thermistor8ch

module CellSim16Ch:
    """
    Cellsim 16ch module
    """
    # HIL Core
    hil_core = new HILCore

    # Cells
    cell_block_1_8 = new CellSim8Ch
    cell_block_9_16 = new CellSim8Ch

    # Power cells
    hil_core.power_24v ~ cell_block_1_8.power_24v
    hil_core.power_24v ~ cell_block_9_16.power_24v
    hil_core.power_5v ~ cell_block_1_8.power_5v
    hil_core.power_5v ~ cell_block_9_16.power_5v
    hil_core.power_3v3 ~ cell_block_1_8.power_3v3
    hil_core.power_3v3 ~ cell_block_9_16.power_3v3

    # I2C
    hil_core.controller.i2c0 ~ cell_block_1_8.i2c
    hil_core.controller.i2c1 ~ cell_block_9_16.i2c

    # Connect blocks
    cell_block_1_8.block_up ~ cell_block_9_16.block_down

    # Connect LED Data
    hil_core.controller.led_data ~ cell_block_1_8.block_down.led_data

    # Cell Output Connector
    cell_output_connector = new IDCVSH16S
    cell_block_1_8.cell1.power_out.gnd ~ cell_output_connector.cell0
    cell_block_1_8.cell1.power_out.vcc ~ cell_output_connector.cell1
    cell_block_1_8.cell2.power_out.vcc ~ cell_output_connector.cell2
    cell_block_1_8.cell3.power_out.vcc ~ cell_output_connector.cell3
    cell_block_1_8.cell4.power_out.vcc ~ cell_output_connector.cell4
    cell_block_1_8.cell5.power_out.vcc ~ cell_output_connector.cell5
    cell_block_1_8.cell6.power_out.vcc ~ cell_output_connector.cell6
    cell_block_1_8.cell7.power_out.vcc ~ cell_output_connector.cell7
    cell_block_1_8.cell8.power_out.vcc ~ cell_output_connector.cell8
    cell_block_9_16.cell1.power_out.vcc ~ cell_output_connector.cell9
    cell_block_9_16.cell2.power_out.vcc ~ cell_output_connector.cell10
    cell_block_9_16.cell3.power_out.vcc ~ cell_output_connector.cell11
    cell_block_9_16.cell4.power_out.vcc ~ cell_output_connector.cell12
    cell_block_9_16.cell5.power_out.vcc ~ cell_output_connector.cell13
    cell_block_9_16.cell6.power_out.vcc ~ cell_output_connector.cell14
    cell_block_9_16.cell7.power_out.vcc ~ cell_output_connector.cell15
    cell_block_9_16.cell8.power_out.vcc ~ cell_output_connector.cell16

    cell_block_1_8.cell1.power_out.gnd ~ cell_output_connector.power.gnd
    cell_block_9_16.cell8.power_out.vcc ~ cell_output_connector.power.vcc

    # Thermistors
    thermistor_8ch = new Thermistor8ch

    # Power thermistors
    hil_core.power_24v ~ thermistor_8ch.power_24v
    hil_core.power_3v3 ~ thermistor_8ch.power_3v3

    # Connect thermistors
    thermistor_connector = new NTCIDC8CH
    thermistor_8ch.thermistor_1 ~ thermistor_connector.ntc1
    thermistor_8ch.thermistor_2 ~ thermistor_connector.ntc2
    thermistor_8ch.thermistor_3 ~ thermistor_connector.ntc3
    thermistor_8ch.thermistor_4 ~ thermistor_connector.ntc4
    thermistor_8ch.thermistor_5 ~ thermistor_connector.ntc5
    thermistor_8ch.thermistor_6 ~ thermistor_connector.ntc6
    thermistor_8ch.thermistor_7 ~ thermistor_connector.ntc7
    thermistor_8ch.thermistor_8 ~ thermistor_connector.ntc8

    # I2C
    hil_core.controller.i2c2 ~ thermistor_8ch.i2c

    # CAN Interface
    can_controller = new ComsCANISO
    # can_controller.termination -> TerminatedCAN120R

    # Power
    hil_core.power_5v ~ can_controller.power_5v
    hil_core.power_3v3 ~ can_controller.power_3v3

    # SPI
    hil_core.controller.spi0 ~ can_controller.spi
    hil_core.controller.spi0_cs0 ~ can_controller.spi_cs
    hil_core.controller.cm5.gpio_6 ~ can_controller.interrupt

    # Connector
    can_connector = new DB9RightAngleMale
    can_controller.can.CANL ~ can_connector.2
    can_controller.can.CANH ~ can_connector.7
    can_controller.termination.gnd ~ can_connector.6

    # Test points
    debug_saleae_i2c0_i2c_1 = new DebugSaleae
    debug_saleae_i2c0_i2c_1.i2c ~ hil_core.controller.i2c0
    debug_saleae_i2c0_i2c_1.i2c2 ~ hil_core.controller.i2c1

    debug_saleae_i2c2_i2c_3 = new DebugSaleae
    debug_saleae_i2c2_i2c_3.i2c ~ hil_core.controller.i2c2
    debug_saleae_i2c2_i2c_3.i2c2 ~ hil_core.controller.i2c3

    debug_saleae_spi0 = new DebugSaleae
    debug_saleae_spi0.spi ~ hil_core.controller.spi0
    debug_saleae_spi0.spi_cs ~ hil_core.controller.spi0_cs0

    debug_saleae_power = new DebugSaleae
    debug_saleae_power.ch0.line ~ hil_core.power_5v.vcc
    debug_saleae_power.ch1.line ~ hil_core.power_3v3.vcc
    debug_saleae_power.ch0.reference.gnd ~ hil_core.power_5v.gnd
    debug_saleae_power.ch1.reference.gnd ~ hil_core.power_3v3.gnd
